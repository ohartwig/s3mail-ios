S3mailCore.xcframework/
.build/
.swiftpm/
DerivedData/

# Xcode's per-user state. The shared scheme under xcshareddata belongs in the
# repository - without it the Mac runner finds no scheme to build.
xcuserdata/
*.xcuserdatad
